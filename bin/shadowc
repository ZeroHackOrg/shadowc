#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""shadowc launcher - runs from the repository source tree without install.

Usage:
    ./bin/shadowc firmware.c --target arm64 -o firmware_hardened
    ./bin/shadowc --status
"""

import os
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))
_ROOT = os.path.dirname(_HERE)
_SRC = os.path.join(_ROOT, "src")

if _SRC not in sys.path:
    sys.path.insert(0, _SRC)

from shadowc.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())